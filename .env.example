# Optional environment variables

# Node environment
NODE_ENV=development

# Next.js port (default 3000)
# PORT=3000

# Optional: Set temporary directory for scans (defaults to system /tmp)
# SCAN_TEMP_DIR=/tmp

# Optional: Max file size to scan in MB (default 10)
# MAX_FILE_SIZE=10

# Optional: Max scan duration in seconds (default 300)
# MAX_SCAN_DURATION=300
